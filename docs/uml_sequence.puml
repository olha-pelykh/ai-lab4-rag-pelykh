@startuml uml_sequence
title Виклик ask() (dense-пошук, конфігурація A, TOP_K=3, THRESHOLD=0.74)
actor "src/rag.py\nблок main" as main
participant "ask()" as ask
participant "store\nInMemoryVectorStore" as store
participant "HuggingFaceEmbeddings\nBAAI/bge-small-en-v1.5" as emb
participant "rag_chain\nrag_prompt | llm | StrOutputParser" as chain
participant "ChatOllama\nqwen2.5:3b" as llm

main -> ask : ask(question, store, k=3, threshold=0.74)
ask -> store : similarity_search_with_score(question, k=3)
store -> emb : embed_query(question)
emb --> store : вектор (384 виміри, нормалізований)
store --> ask : hits = [(Document, score)] × 3

alt hits[0][1] < 0.74 (схожість top-1 нижча за поріг)
  ask --> main : REFUSAL = "НЕМАЄ У ДОКУМЕНТІ", [], t_retr, 0.0
else схожість top-1 ≥ 0.74
  ask -> ask : format_docs(docs)\n"[стор. N] текст чанка" × 3
  ask -> chain : invoke({context, question})
  chain -> llm : промпт SYSTEM + context + question\n(temperature=0, seed=12)
  llm --> chain : текст відповіді
  chain --> ask : StrOutputParser() → str
  ask --> main : text, pages, t_retr, t_gen
end

opt Е2 (src/experiment.py): переранжування замість прямого top-3
  ask -> store : similarity_search_with_score(question, k=20)
  store --> ask : 20 кандидатів
  ask -> "CrossEncoder\nms-marco-MiniLM-L-6-v2" as ce : predict([(question, chunk) × 20])
  ce --> ask : оцінки релевантності
  note right of ask : сортування за оцінкою,\nзалишається top-k
end
@enduml
